# Required
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6

# Application under test
BASE_URL=https://your-qa-environment.example.com

# Optional test credentials. Prefer your secret manager/CI variables in real projects.
CLIENT_ADMIN_USERNAME=
CLIENT_ADMIN_PASSWORD=
CLIENT_VIEWER_USERNAME=
CLIENT_VIEWER_PASSWORD=
RESIDENT_USERNAME=
RESIDENT_PASSWORD=

# Playwright MCP
PLAYWRIGHT_MCP_COMMAND=npx
PLAYWRIGHT_MCP_PACKAGE=@playwright/mcp@latest
PLAYWRIGHT_MCP_HEADLESS=false
PLAYWRIGHT_MCP_BROWSER=chromium

# Execution controls
MAX_AGENT_TURNS=40
MAX_RECOVERY_ATTEMPTS=2
STEP_TIMEOUT_MS=45000


