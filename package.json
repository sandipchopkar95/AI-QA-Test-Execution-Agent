{
  "name": "ai-qa-test-execution-agent",
  "version": "1.0.0",
  "private": true,
  "description": "AI QA Test Execution Agent: Excel/plain-English test cases -> OpenAI planner -> Playwright MCP -> evidence/reporting.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "run": "tsx src/index.ts",
    "run:sample": "tsx src/index.ts --file test-data/sample-test-cases.xlsx",
    "run:sample:demo": "tsx src/index.ts --file test-data/sample-test-cases.xlsx --demo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "dotenv": "^17.2.2",
    "exceljs": "^3.4.0",
    "openai": "^6.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
